# UC Learn credentials — copy this to .env and fill in your details
# NEVER commit .env to git

UC_USERNAME=your.username@uclive.ac.nz
UC_PASSWORD=your_password_here

# Where to save downloaded files (default: ~/Desktop/Uni/2026/)
# UC_BASE_DIR=/path/to/your/uni/folder

# Session cookie file (default: ~/.uc_session.json)
# UC_SESSION_FILE=/path/to/uc_session.json

# Run browser in background (true) or visible (false)
# UC_HEADLESS=true

# How many days ahead to show in digest
# UC_DIGEST_DAYS=7

# ── AI crypto trader (see AI_TRADER.md) ─────────────────────
# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# paper = fake money at real prices (default). live = real orders.
TRADER_MODE=paper
# Any ccxt exchange id: kraken, binance, coinbase, kucoin, ...
TRADER_EXCHANGE=kraken
TRADER_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
# TRADER_MODEL=claude-opus-5-5
# TRADER_EFFORT=high
# TRADER_DATA_DIR=C:\Users\you\ai_trader_data
# PAPER_STARTING_CASH=10000

# Claude spending caps in US$, covering trading and backtests (0 = no cap)
# CLAUDE_DAILY_BUDGET_USD=5
# CLAUDE_MONTHLY_BUDGET_USD=40

# Risk limits (percent of total equity unless noted)
# RISK_MAX_POSITION_PCT=25
# RISK_MAX_TRADE_PCT=10
# RISK_MIN_CASH_PCT=20
# RISK_MIN_CONFIDENCE=0.6
# RISK_MAX_DAILY_LOSS_PCT=5
# RISK_STOP_LOSS_PCT=8
# RISK_MIN_ORDER_USD=10

# Live trading only: exchange API key with TRADE permission, NEVER withdrawal permission
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# EXCHANGE_API_PASSWORD=
# LIVE_TRADING_CONFIRMED=I_UNDERSTAND_THE_RISKS
